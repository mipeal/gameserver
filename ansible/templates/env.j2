# Managed by ansible (ansible/templates/env.j2) — do not edit on the server.
IMAGE_REGISTRY={{ gameserver_image_registry }}

POSTGRES_SERVER={{ 'postgres' if gameserver_postgres_local | bool else gameserver_postgres_server }}
POSTGRES_PORT={{ gameserver_postgres_port }}
POSTGRES_DB={{ gameserver_postgres_db }}
POSTGRES_USER={{ gameserver_postgres_user }}
POSTGRES_PASSWORD={{ gameserver_postgres_password }}

REDIS_HOST={{ gameserver_redis_host }}
REDIS_PORT={{ gameserver_redis_port }}
REDIS_DB={{ gameserver_redis_db }}
REDIS_PASSWORD={{ gameserver_redis_password }}

SECRET_FLAG_KEY={{ gameserver_secret_flag_key }}

CONFIG_FILE=/opt/config.yaml
PUBLIC_SCOREBOARD_PATH=/var/public/scoreboard
INTERNAL_SCOREBOARD_PATH=/var/internal/scoreboard

# submitter_telegraf metrics sidecar (only used with gameserver_telegraf_enabled=true)
TIMESCALE_SERVER={{ gameserver_timescale_server }}
TIMESCALE_DB={{ gameserver_timescale_db }}
TIMESCALE_USER={{ gameserver_timescale_user }}
TIMESCALE_PASSWORD={{ gameserver_timescale_password }}
