# Rust gameserver image (see rust/cutover.sh). Base is the same python:3.13
# as the original Dockerfile, because the checker subprocesses still run the
# Python checker scripts (ADR-013). The rust bins are compiled inside docker
# so `docker buildx build --platform linux/amd64,linux/arm64` works (the rust
# builder stage runs per target platform, natively or under QEMU).

# syntax=docker/dockerfile:1
FROM rust:1-bookworm AS rust_build
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY rust/saarctf-commons-rs ./saarctf-commons-rs
COPY rust/gamelib-rs ./gamelib-rs
COPY rust/controlserver-rs ./controlserver-rs
WORKDIR /build/controlserver-rs
RUN cargo build --release --bins
COPY rust/saarctf-scripts-rs /build/saarctf-scripts-rs
COPY rust/vpnboard-rs /build/vpnboard-rs
WORKDIR /build/vpnboard-rs
RUN cargo build --release --bins

# index.css is a build artifact (npm run less: less/index.less ->
# controlserver/static/css/index.css); the scoreboard generator copies it into
# its output and the scoreboard is unstyled when it is missing. The less
# sources moved to rust/controlserver-rs/less (controlserver/ Python deleted,
# ADR-017).
FROM node:20-bookworm AS css_build
WORKDIR /build
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY rust/controlserver-rs/less ./rust/controlserver-rs/less
RUN npx lessc --include-path=node_modules --modify-var='@env-name="None"' \
    rust/controlserver-rs/less/index.less /build/index.css

# checker-exec embeds CPython (PyO3) and needs python3.13 headers + libpython
# (ADR-017); the other rust bins stay on rust:1-bookworm above.
FROM python:3.13-bookworm AS checker_build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
COPY rust/checker-exec /build/checker-exec
WORKDIR /build/checker-exec
RUN cargo build --release

FROM python:3.13
WORKDIR /opt

ADD requirements* /opt/
ADD Makefile /opt/
ADD gamelib /opt/gamelib

RUN --mount=type=cache,target=/root/.cache \
    make deps && . venv/bin/activate && pip install gunicorn pwntools && mkdir -p scoreboard \
    && apt-get update && apt-get install -y --no-install-recommends iproute2 wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

ADD checker_runner /opt/checker_runner
ADD saarctf_commons /opt/saarctf_commons
ADD sample_files /opt/sample_files

COPY --from=css_build /build/index.css /opt/controlserver/static/css/index.css

# Runtime assets the vpnboard daemon copies into its output dir
# (vpnboard-rs/board.rs copy_static_files); moved out of the deleted
# controlserver/ tree (ADR-017).
COPY rust/vpnboard-rs/static/css/vpnboard.css /opt/controlserver/static/css/vpnboard.css
COPY rust/vpnboard-rs/static/img/favicon.png /opt/controlserver/static/img/favicon.png

# Leptos scoreboard SPA where the scoreboard generator expects it
# (python_dir/scoreboard/dist/scoreboard — the Angular build layout). Trunk
# outputs flat, so nest it one level. Built on the host by cutover.sh — the
# wasm output is platform-independent.
COPY rust/scoreboard-rs/dist/ /opt/scoreboard/dist/scoreboard/

# Leptos admin GUI SPA, served by the controlserver on its HTTP port
COPY rust/admin-gui-rs/dist/ /opt/admin-gui/dist/
ENV ADMIN_GUI_DIST=/opt/admin-gui/dist

COPY --from=rust_build \
    /build/controlserver-rs/target/release/controlserver \
    /build/controlserver-rs/target/release/checker_runner \
    /build/controlserver-rs/target/release/scoreboard \
    /usr/local/bin/
COPY --from=rust_build \
    /build/vpnboard-rs/target/release/vpn-status-daemon \
    /usr/local/bin/vpn-status-daemon
COPY --from=checker_build \
    /build/checker-exec/target/release/checker-exec \
    /usr/local/bin/checker-exec

ENV SAARCTF_PYTHON_DIR=/opt
# checker-exec embeds CPython; /opt/venv first so the shim's imports (and the
# demo_checker special) resolve against the venv with deps
ENV PATH="/opt/venv/bin:${PATH}"
STOPSIGNAL SIGINT
ENTRYPOINT []
